# Скопируйте в .env.local и подставьте значения из Supabase → Project Settings → API.
# Облачный проект: URL вида https://<project-ref>.supabase.co (не используйте 127.0.0.1:54321 для деплоя и Docker).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Только локально. На Vercel НЕ добавляйте (в production игнорируется).
# SKIP_AUTH_MIDDLEWARE=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo — email-уведомления клиентам при смене статуса (только server-side, не NEXT_PUBLIC_)
# API key: Brevo → SMTP & API → API Keys
# Sender: подтверждённый email в Brevo → Senders
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Emigrant Croatia Desk
# Локально на Windows при ошибке SSL к Brevo: BREVO_SKIP_TLS_VERIFY=true
# (в production не задавать; npm run dev уже задаёт NODE_TLS_REJECT_UNAUTHORIZED=0)

# Google Sheets / Formgrid — автосоздание клиентов из анкеты
# Таблицу расшарьте на GOOGLE_SERVICE_ACCOUNT_EMAIL (роль «Читатель»).
GOOGLE_SHEETS_FORMGRID_SPREADSHEET_ID=1S8Y0VCaAQ78wxg5Rxl8fcFMkwSsvr-X-cLrAlK4nF9Q
GOOGLE_SHEETS_FORMGRID_GID=0
GOOGLE_SERVICE_ACCOUNT_EMAIL=sharp-spice-platform@project-3bfd25e8-8781-480b-8f9.iam.gserviceaccount.com
# Вариант A: только private_key (одна строка с \n)
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Вариант B (проще для Vercel): весь JSON service account одной переменной
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# Колонки Formgrid (можно не задавать — совпадают с дефолтами в коде)
# FORMGRID_COLUMN_FULL_NAME=1. Фамилия, Имя, Отчество (кириллицей)
# FORMGRID_COLUMN_EMAIL=Электронный адрес (только .com)
# FORMGRID_COLUMN_PASSPORT=8. № заграничного паспорта

# Vercel Cron: секрет для /api/cron/sync-formgrid (заголовок Authorization: Bearer ...)
CRON_SECRET=

# Google Drive — база знаний для AI-ассистента (папку расшарьте на GOOGLE_SERVICE_ACCOUNT_EMAIL)
GOOGLE_DRIVE_KB_FOLDER_ID=1sRGV_EbSfYCv-2cfhhoEQ3_jN_yh-Dr1
# ID папок, которые не читать (через запятую), например внутренняя папка Clients
GOOGLE_DRIVE_KB_EXCLUDE_FOLDER_IDS=1eKwZoFPQlINyhjLP915n0TenT7Lom1Cn

# OpenRouter — AI-ассистент в клиентском кабинете (только server-side)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_WORKSPACE_MODEL=anthropic/claude-sonnet-4
AI_WORKSPACE_TEMPERATURE=0.4
AI_WORKSPACE_MAX_TOKENS=1500
AI_WORKSPACE_STREAM=true
